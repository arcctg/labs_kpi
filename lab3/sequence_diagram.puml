@startuml
title Sequence Diagram: Conduction of an appointment

skinparam sequenceActorStyle stickman
skinparam sequenceReferenceBackgroundColor #EFEFEF
skinparam sequenceArrowThickness 2
skinparam sequenceParticipant borderThickness 1.5

actor "Doctor" as Doctor
participant "EMR_System" as System <<Gateway>>
participant "AppointmentService" as ApptSvc <<Service>>
participant "MedicalRecordService" as RecordSvc <<Service>>
participant "TreatmentService" as TrmSvc <<Service>>
database "Database" as DB

activate DB
activate Doctor

Doctor -> System: startAppointment(apptId)
    activate System
    System -> ApptSvc: getAppointmentDetails(apptId)
        activate ApptSvc
        ApptSvc -> DB: SELECT * FROM Appointment WHERE id=...
        DB --> ApptSvc: appointmentData (incl. patientId)
        ApptSvc --> System: {appointmentData, patientId}
        deactivate ApptSvc

    System -> RecordSvc: getMedicalHistory(patientId)
        activate RecordSvc
        RecordSvc -> DB: SELECT * FROM MedicalRecord WHERE patient_id=...
        DB --> RecordSvc: recordData
        RecordSvc -> DB: SELECT * FROM Treatment WHERE record_id=...
        DB --> RecordSvc: pastTreatments
        RecordSvc --> System: fullMedicalHistory
        deactivate RecordSvc

    System --> Doctor: displayAppointmentDetails(data)
deactivate System

Doctor -> System: addDiagnosis(patientId, symptoms, diagnosisInfo)
    activate System
    System -> TrmSvc: createDiagnosis(patientId, diagnosisInfo)
        activate TrmSvc
        TrmSvc -> DB: INSERT INTO Diagnosis ...
        DB --> TrmSvc: newDiagnosisId
        TrmSvc -> DB: INSERT INTO Treatment (record_id, diagnosis_id, ...)
        DB --> TrmSvc: newTreatmentId
        TrmSvc --> System: {treatmentConfirmation, newTreatmentId}
        deactivate TrmSvc
    System --> Doctor: displayDiagnosisConfirmation()
    deactivate System

' Використання optional-блоку, як у лекції [cite: 340, 349]
opt Needs Prescription
    Doctor -> System: addPrescription(newTreatmentId, medInfo)
        activate System
        System -> TrmSvc: createPrescription(newTreatmentId, medInfo)
            activate TrmSvc

            ' Можна додати логіку пошуку медикаментів
            TrmSvc -> DB: SELECT medication_id FROM Medication WHERE name=...
            DB --> TrmSvc: medicationId

            TrmSvc -> DB: INSERT INTO Prescription (treatment_id, medication_id, ...)
            DB --> TrmSvc: prescriptionConfirmation
            TrmSvc --> System: prescriptionConfirmation
            deactivate TrmSvc
        System --> Doctor: displayPrescriptionAdded()
        deactivate System
end

Doctor -> System: completeAppointment(apptId)
    activate System
    System -> ApptSvc: updateAppointmentStatus(apptId, "Completed")
        activate ApptSvc
        ApptSvc -> DB: UPDATE Appointment SET status='Completed' WHERE id=...
        DB --> ApptSvc: updateSuccess
        ApptSvc --> System: confirmation
        deactivate ApptSvc
    System --> Doctor: displayConfirmation("Прийом завершено")
    deactivate System

deactivate Doctor
deactivate DB

@enduml